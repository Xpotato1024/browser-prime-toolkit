  "script": "set -eu\ncd /src\nFLAGS=\"-O2 -std=gnu99 -DCPU_GENERIC -D_GMP_XFACE_H_ -Iinclude -Impqs -Inative/siqs-v2 -fwasm-exceptions -sSUPPORT_LONGJMP=wasm\"\nfor n in mpqs poly relation sieve sqrt; do emcc $FLAGS -include native/siqs-v2/runtime.h -c mpqs/$n.c -o /work/$n.o; done\nfor n in mp prime_delta prime_sieve squfof; do emcc $FLAGS -include native/siqs-v2/runtime.h -c common/$n.c -o /work/$n.o; done\nfor b in 32 64; do emcc $FLAGS -include native/siqs-v2/runtime.h -DBLOCK_KB=$b -DROUTINE_NAME=qs_core_sieve_generic_\"$b\"k -c mpqs/sieve_core.c -o /work/core$b.o; done\nemcc $FLAGS -c native/siqs-v2/runtime.c -o /work/runtime.o\nemcc $FLAGS -c native/siqs-v2/matrix-lanczos.c -o /work/matrix.o\nemcc $FLAGS -include native/siqs-v2/runtime.h -c lanczos.c -o /work/lanczos.o\nemcc /work/*.o -O2 -fwasm-exceptions -sSUPPORT_LONGJMP=wasm --no-entry -sSTANDALONE_WASM=1 -sFILESYSTEM=0 -sALLOW_MEMORY_GROWTH=0 -sINITIAL_MEMORY=67108864 -sSTACK_SIZE=1048576 -sMALLOC=emmalloc '-sEXPORTED_FUNCTIONS=[\"_input_ptr\",\"_factor_ptr\",\"_siqs_split\",\"_stat_live\",\"_stat_peak\",\"_stat_phases\",\"_stat_reason\",\"_configure_fault\",\"_stat_line\",\"_log_ptr\",\"_stat_allocs\",\"_configure_checkpoint_budget\",\"_stat_work\",\"_stat_imports\",\"_stat_operation_stop\",\"_stat_phase_work\",\"_stat_lanczos_attempts\",\"_stat_lanczos_iterations\",\"_configure_snapshot\",\"_stat_snapshot_ptr\",\"_stat_snapshot_bytes\",\"_stat_parity_ptr\",\"_stat_parity_bytes\"]' -o /work/siqs.wasm\n",
