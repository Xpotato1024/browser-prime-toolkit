  "recipe": "set -eu\ntrap 'rc=$?; if [ \"$rc\" -ne 0 ]; then tail -n 30 /work/*.log >&2; fi' EXIT\nfor pkg in /src/*.deb; do dpkg-deb -x \"$pkg\" /; done\nexport LC_ALL=C TZ=UTC SOURCE_DATE_EPOCH=1773093262\nmkdir /work/gmp /work/msieve\ntar --no-same-owner --no-same-permissions -xzf /src/gmp.tar.gz --strip-components=1 -C /work/gmp\ntar --no-same-owner --no-same-permissions -xzf /src/msieve.tar.gz --strip-components=1 -C /work/msieve\ncd /work/gmp\nexport CFLAGS=\"-O2\" LDFLAGS=\"-sALLOW_MEMORY_GROWTH=0\"\nemconfigure ./configure \"CCAS=gcc -c\" --host=none --build=x86_64-pc-linux-gnu --disable-assembly --disable-shared --disable-cxx > /work/configure.log 2>&1\nemmake make -j2 all > /work/gmp.log 2>&1\npython3 - <<'PY'\nimport json,hashlib\nfrom pathlib import Path\nroot=Path('/work/msieve')\nfor name,e in json.loads(Path('/src/patched.json').read_text()).items():\n p=root/name\n assert hashlib.sha256(p.read_bytes()).hexdigest()==e['originalSha256'],name\n p.write_text(e['text'])\n assert hashlib.sha256(p.read_bytes()).hexdigest()==e['sha256'],name\nPY\ncp /src/native/siqs-lab/runtime.c /work/msieve/demo.c\ncd /work/msieve\nexport CFLAGS=\"-flto -I/work/gmp -Impqs -I/src/native/siqs-lab -include /src/native/siqs-lab/runtime.h -fwasm-exceptions -sSUPPORT_LONGJMP=wasm\"\nexport LDFLAGS=\"-flto -fwasm-exceptions -sSUPPORT_LONGJMP=wasm -sENVIRONMENT=web,worker -sFILESYSTEM=0 -sMODULARIZE=1 -sEXPORT_ES6=1 -sINVOKE_RUN=0 -sEXIT_RUNTIME=1 -sALLOW_MEMORY_GROWTH=0 -sINITIAL_MEMORY=268435456 -sSTACK_SIZE=4194304 -sWASM_BIGINT=1 -sEXPORTED_FUNCTIONS=['_malloc','_abort','_large_input_ptr','_large_accept','_large_run','_large_work','_large_phase','_large_saved','_large_configure','_large_nnz','_large_reason','_large_line','_lab_configure','_lab_save_ptr','_lab_import_ptr','_lab_import','_lab_release','_lab_stat','_lab_timer','_lab_timer_calls','_lab_timer_open','_lab_timer_elapsed'] -sEXPORTED_RUNTIME_METHODS=['UTF8ToString','HEAPU8'] --js-library /src/native/siqs-lab/callbacks.js -L/work/gmp/.libs -Wl,-Map=/work/link.map\"\nemmake make -j2 all CC=emcc AR=emar RANLIB=emranlib NO_ZLIB=1 NFS_OBJS= GPU_OBJS= > /work/msieve.log 2>&1\ncp msieve /work/full.mjs\ncp msieve.wasm /work/full.wasm\n",
